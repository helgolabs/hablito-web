---
interface Props {
  verb?: string;
  message?: string;
}

const {
  verb,
  message = verb
    ? `Ready to practice ${verb}?`
    : 'Ready to put this into practice?',
} = Astro.props;
---

<div class="cta">
  <div class="cta-inner">
    <div class="cta-text">
      <p class="cta-message">{message}</p>
      <p class="cta-body">
        Hablito drills verb conjugations across all tenses until they become automatic —
        free, no account needed.
      </p>
    </div>
    <a href="/" class="cta-button">Practice free →</a>
  </div>
</div>

<style>
  .cta {
    background: #003087;
    border-radius: 12px;
    padding: 1.5rem;
    margin: 2.5rem 0;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .cta-text {
    flex: 1;
  }

  .cta-message {
    font-size: 1rem;
    color: #ffffff;
    margin-bottom: 0.3rem;
    line-height: 1.4;
  }

  .cta-body {
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.85rem;
    line-height: 1.5;
    margin: 0;
  }

  .cta-button {
    display: inline-block;
    background: #19857b;
    color: #ffffff;
    font-size: 0.9rem;
    padding: 0.6rem 1.25rem;
    border-radius: 20px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s;
    flex-shrink: 0;
  }

  .cta-button:hover {
    background: #136257;
  }

  @media (max-width: 540px) {
    .cta-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
