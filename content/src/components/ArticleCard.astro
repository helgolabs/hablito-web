---
interface Props {
  title: string;
  description: string;
  slug: string;
  tags: string[];
}

const { title, description, slug, tags } = Astro.props;
---

<a href={`/learn/${slug}`} class="card">
  <div class="card-body">
    <h2 class="card-title">{title}</h2>
    <p class="card-description">{description}</p>
    {tags.length > 0 && (
      <ul class="card-tags">
        {tags.map(tag => <li class="tag">{tag}</li>)}
      </ul>
    )}
  </div>
  <span class="card-arrow">→</span>
</a>

<style>
  .card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-left: 4px solid #003087;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.1s;
  }

  .card:hover {
    border-left-color: #19857b;
    box-shadow: 0 4px 16px rgba(0, 48, 135, 0.1);
    transform: translateY(-1px);
  }

  .card-body {
    flex: 1;
    min-width: 0;
  }

  .card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #003087;
    margin-bottom: 0.35rem;
    line-height: 1.3;
  }

  .card-description {
    font-size: 0.88rem;
    color: #64748b;
    line-height: 1.5;
    margin-bottom: 0.65rem;
  }

  .card-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag {
    background: #e8f0fe;
    color: #003087;
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
  }

  .card-arrow {
    color: #19857b;
    font-size: 1.1rem;
    flex-shrink: 0;
    transition: transform 0.15s;
  }

  .card:hover .card-arrow {
    transform: translateX(3px);
  }
</style>
