---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import { Analytics } from '@vercel/analytics/astro';

const articles = (await getCollection('learn')).sort(
  (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
);

const title = 'Learn Spanish — Guides & Explanations';
const description =
  'Clear explanations of Spanish grammar, vocabulary, and usage. Understand why, not just what.';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Hablito</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/conjugito-round-logo.png" />
  </head>
  <body>
    <header>
      <nav>
        <div class="nav-left">
          <img src="/conjugito-round-logo.png" alt="Hablito logo" class="nav-logo" />
          <a href="/" class="nav-brand">Hablito <span class="nav-brand-sub">learn</span></a>
        </div>
        <div class="nav-right">
          <a href="/" class="nav-cta">Practice free →</a>
        </div>
      </nav>
    </header>

    <main>
      <div class="hub-header">
        <h1>Learn Spanish</h1>
        <p>
          Practical guides on grammar, word choice, and usage —
          the things that actually trip learners up.
        </p>
      </div>

      <div class="article-grid">
        {articles.map(article => (
          <ArticleCard
            title={article.data.title}
            description={article.data.description}
            slug={article.slug}
            tags={article.data.tags}
          />
        ))}
      </div>
    </main>

    <footer>
      <p>
        Put it into practice with <a href="/">Hablito</a> — free verb conjugation drills, no account needed.
      </p>
    </footer>
    <Analytics />
  </body>
</html>

<style>
  @font-face {
    font-family: 'SofiaProRegular';
    src: url('/fonts/SofiaProRegular.woff2') format('woff2');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'SofiaProMedium';
    src: url('/fonts/SofiaProMedium.woff2') format('woff2');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --max-width: 720px;
    --color-bg: #fefbff;
    --color-border: #e2e8f0;
    --color-muted: #64748b;
    --color-primary: #003087;
    --color-teal: #19857b;
    --color-teal-dark: #136257;
    --font-sans: 'SofiaProRegular', system-ui, -apple-system, sans-serif;
    --font-medium: 'SofiaProMedium', system-ui, -apple-system, sans-serif;
  }

  html { font-size: 18px; }

  body {
    font-family: var(--font-sans);
    background: var(--color-bg);
    color: #1b1b1f;
    line-height: 1.6;
  }

  header {
    background: var(--color-primary);
    position: sticky;
    top: 0;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
  }

  nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .nav-logo {
    height: 32px;
    width: 32px;
    border-radius: 50%;
  }

  .nav-brand {
    font-family: var(--font-medium);
    font-size: 1.1rem;
    color: #ffffff;
    text-decoration: none;
    letter-spacing: 0.01em;
  }

  .nav-brand-sub {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: rgba(255,255,255,0.7);
    font-weight: normal;
    margin-left: 0.2rem;
  }

  .nav-right {
    display: flex;
    align-items: center;
  }

  .nav-cta {
    font-size: 0.85rem;
    font-family: var(--font-medium);
    color: #ffffff;
    background: var(--color-teal);
    text-decoration: none;
    padding: 0.4rem 0.9rem;
    border-radius: 20px;
    transition: background 0.15s;
  }

  .nav-cta:hover { background: var(--color-teal-dark); }

  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }

  .hub-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 3px solid var(--color-primary);
  }

  .hub-header h1 {
    font-family: var(--font-medium);
    font-size: 2.2rem;
    font-weight: normal;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
    color: var(--color-primary);
  }

  .hub-header p {
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .article-grid {
    display: grid;
    gap: 1rem;
  }

  footer {
    background: var(--color-primary);
    padding: 2rem 1.5rem;
    text-align: center;
    color: rgba(255,255,255,0.75);
    font-size: 0.9rem;
  }

  footer a {
    color: #ffffff;
    font-family: var(--font-medium);
    text-decoration: none;
  }

  footer a:hover { text-decoration: underline; }

  @media (max-width: 600px) {
    html { font-size: 16px; }
    .hub-header h1 { font-size: 1.75rem; }
  }
</style>
