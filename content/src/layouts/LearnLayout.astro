---
import { Analytics } from '@vercel/analytics/astro';

interface Props {
  title: string;
  description: string;
  pubDate?: Date;
}

const { title, description, pubDate } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Hablito</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/conjugito-round-logo.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": description,
      "datePublished": pubDate?.toISOString(),
      "publisher": {
        "@type": "Organization",
        "name": "Hablito",
        "url": "https://www.hablito.com"
      }
    })} />
    <style is:global>
      @font-face {
        font-family: 'SofiaProRegular';
        src: url('/fonts/SofiaProRegular.woff2') format('woff2');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: 'SofiaProMedium';
        src: url('/fonts/SofiaProMedium.woff2') format('woff2');
        font-weight: 600;
        font-style: normal;
        font-display: swap;
      }

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --color-bg: #fefbff;
        --color-text: #1b1b1f;
        --color-muted: #64748b;
        --color-primary: #003087;
        --color-primary-dim: rgba(0, 48, 135, 0.08);
        --color-teal: #19857b;
        --color-teal-dark: #136257;
        --color-teal-light: #e6f4f2;
        --color-accent-light: #e8f0fe;
        --color-border: #e2e8f0;
        --color-code-bg: #f1f5f9;
        --font-sans: 'SofiaProRegular', system-ui, -apple-system, sans-serif;
        --font-medium: 'SofiaProMedium', system-ui, -apple-system, sans-serif;
        --max-width: 720px;
      }

      html {
        font-size: 18px;
        -webkit-text-size-adjust: 100%;
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-sans);
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.75;
      }

      /* Reading progress bar */
      #progress-bar {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        width: 0%;
        background: var(--color-teal);
        z-index: 100;
        transition: width 0.1s linear;
      }

      /* Site nav — scoped to .site-header to avoid bleeding into article <header> */
      .site-header {
        background: var(--color-primary);
        position: sticky;
        top: 0;
        z-index: 10;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
      }

      .site-header nav {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 1.5rem;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .nav-left {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .nav-logo {
        height: 32px;
        width: 32px;
        border-radius: 50%;
      }

      .nav-brand {
        font-family: var(--font-medium);
        font-size: 1.1rem;
        color: #ffffff;
        text-decoration: none;
        letter-spacing: 0.01em;
      }

      .nav-brand-sub {
        font-family: var(--font-sans);
        font-size: 0.85rem;
        color: rgba(255,255,255,0.65);
        margin-left: 0.15rem;
      }

      .nav-right {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .nav-guides {
        font-size: 0.85rem;
        color: rgba(255,255,255,0.75);
        text-decoration: none;
      }

      .nav-guides:hover { color: #ffffff; }

      .nav-cta {
        font-size: 0.85rem;
        font-family: var(--font-medium);
        color: #ffffff;
        background: var(--color-teal);
        text-decoration: none;
        padding: 0.4rem 1rem;
        border-radius: 20px;
        transition: background 0.15s;
        white-space: nowrap;
      }

      .nav-cta:hover { background: var(--color-teal-dark); }

      /* Main */
      main {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 2.5rem 1.5rem 5rem;
      }

      /* Article header — now a div, not a <header>, so no sticky bug */
      .article-header {
        margin-bottom: 2.5rem;
        padding-bottom: 2rem;
        border-bottom: 2px solid var(--color-border);
      }

      .article-eyebrow {
        display: inline-block;
        font-size: 0.75rem;
        font-family: var(--font-medium);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-teal);
        margin-bottom: 0.75rem;
      }

      .article-header h1 {
        font-family: var(--font-medium);
        font-size: 2.2rem;
        line-height: 1.2;
        font-weight: normal;
        letter-spacing: -0.02em;
        margin-bottom: 0.85rem;
        color: var(--color-primary);
      }

      .article-description {
        color: var(--color-muted);
        font-size: 1.05rem;
        line-height: 1.6;
      }

      /* Article body */
      .article-body h2 {
        font-family: var(--font-medium);
        font-size: 1.45rem;
        font-weight: normal;
        margin: 2.75rem 0 0.75rem;
        letter-spacing: -0.01em;
        color: var(--color-primary);
        padding-top: 0.25rem;
      }

      .article-body h3 {
        font-family: var(--font-medium);
        font-size: 1.1rem;
        font-weight: normal;
        margin: 1.75rem 0 0.5rem;
        color: var(--color-teal-dark);
      }

      .article-body p { margin-bottom: 1.25rem; }

      .article-body ul,
      .article-body ol {
        margin: 0 0 1.25rem 1.5rem;
      }

      .article-body li { margin-bottom: 0.5rem; }

      .article-body em {
        font-style: italic;
        color: var(--color-teal-dark);
      }

      .article-body strong {
        font-family: var(--font-medium);
        font-weight: normal;
        color: var(--color-primary);
      }

      .article-body a {
        color: var(--color-teal);
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .article-body a:hover { color: var(--color-teal-dark); }

      /* Tables */
      .article-body table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.75rem 0;
        font-size: 0.95rem;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(0,0,0,0.07);
      }

      .article-body th {
        background: var(--color-primary);
        color: #ffffff;
        padding: 0.7rem 1rem;
        text-align: left;
        font-family: var(--font-medium);
        font-weight: normal;
      }

      .article-body td {
        padding: 0.65rem 1rem;
        border-bottom: 1px solid var(--color-border);
      }

      .article-body tr:last-child td { border-bottom: none; }

      .article-body tr:nth-child(even) td {
        background: var(--color-accent-light);
      }

      .article-body code {
        background: var(--color-code-bg);
        padding: 0.15em 0.45em;
        border-radius: 4px;
        font-size: 0.88em;
        font-family: var(--font-sans);
        color: var(--color-teal-dark);
        border: 1px solid var(--color-border);
      }

      .article-body pre {
        background: var(--color-primary);
        color: #e8f0fe;
        padding: 1.25rem 1.5rem;
        border-radius: 10px;
        overflow-x: auto;
        margin: 1.75rem 0;
        font-size: 0.88rem;
        line-height: 1.7;
      }

      .article-body pre code {
        background: none;
        border: none;
        color: inherit;
        padding: 0;
      }

      .article-body blockquote {
        border-left: 4px solid var(--color-teal);
        background: var(--color-teal-light);
        padding: 1rem 1.25rem;
        margin: 1.75rem 0;
        border-radius: 0 8px 8px 0;
      }

      .article-body blockquote p {
        margin: 0;
        color: var(--color-teal-dark);
        font-size: 0.97rem;
      }

      .article-body hr {
        border: none;
        border-top: 1px solid var(--color-border);
        margin: 3rem 0;
      }

      /* Footer */
      .site-footer {
        background: var(--color-primary);
        padding: 2.5rem 1.5rem;
        text-align: center;
        color: rgba(255,255,255,0.7);
        font-size: 0.875rem;
      }

      .site-footer a {
        color: #ffffff;
        text-decoration: none;
        font-family: var(--font-medium);
      }

      .site-footer a:hover { text-decoration: underline; }

      .site-footer .footer-links {
        margin-top: 0.75rem;
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        font-size: 0.8rem;
      }

      .site-footer .footer-links a {
        color: rgba(255,255,255,0.6);
        font-family: var(--font-sans);
      }

      .site-footer .footer-links a:hover { color: #ffffff; }

      @media (max-width: 600px) {
        html { font-size: 16px; }
        .article-header h1 { font-size: 1.75rem; }
        .article-body table { font-size: 0.85rem; }
        .article-body th, .article-body td { padding: 0.5rem 0.65rem; }
        .nav-guides { display: none; }
        main { padding: 1.75rem 1.25rem 4rem; }
      }
    </style>
  </head>
  <body>
    <div id="progress-bar"></div>

    <header class="site-header">
      <nav>
        <div class="nav-left">
          <img src="/conjugito-round-logo.png" alt="Hablito logo" class="nav-logo" />
          <a href="/" class="nav-brand">Hablito <span class="nav-brand-sub">learn</span></a>
        </div>
        <div class="nav-right">
          <a href="/learn" class="nav-guides">All guides</a>
          <a href="/" class="nav-cta">Practice free →</a>
        </div>
      </nav>
    </header>

    <main>
      <article>
        <div class="article-header">
          <span class="article-eyebrow">Spanish Guide</span>
          <h1>{title}</h1>
          <p class="article-description">{description}</p>
        </div>

        <div class="article-body">
          <slot />
        </div>
      </article>
    </main>

    <footer class="site-footer">
      <p>Master Spanish verb conjugation with <a href="/">Hablito</a> — free, no account needed.</p>
      <nav class="footer-links">
        <a href="/learn">All guides</a>
        <a href="/">Practice app</a>
      </nav>
    </footer>

    <script>
      const bar = document.getElementById('progress-bar');
      function updateProgress() {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        if (bar) bar.style.width = pct + '%';
      }
      window.addEventListener('scroll', updateProgress, { passive: true });
    </script>
    <Analytics />
  </body>
</html>
